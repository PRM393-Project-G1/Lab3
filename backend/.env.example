# Copy to .env. Never commit .env or the service account key.

# Firebase service account key, kept outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=D:\keys\realtron-service-account.json

# Used when the app's AI check is on: reads hard reference lists and looks for
# fabricated references. Choose anthropic, openai or google, and set its key.
# With no provider, GROBID must be running and nothing is checked for fabrication.
REFCHECKER_LLM_PROVIDER=
REFCHECKER_LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional: fewer rate limits when verifying references.
SEMANTIC_SCHOLAR_API_KEY=

# Reads reference lists without an LLM. See README.md.
GROBID_URL=http://localhost:8070

# Saffron. Use forward slashes in SAFFRON_HOME. {corpus}, {output} and {config}
# are filled in for each job. See README.md.
SAFFRON_HOME=D:/tools/saffron-home
SAFFRON_COMMAND='"C:\Program Files\Java\jre-1.8\bin\java" -Xmx3g -cp "D:\tools\saffron-home\lib\*" org.insightcentre.nlp.saffron.run.SaffronPipeline "{corpus}" "{output}" "{config}" -k TAXO'

# Cloudinary, for report uploads while the Firebase project has no Storage bucket.
# The app asks this server to sign each upload; the secret never reaches the phone.
# Leave empty to turn uploads off. See README.md.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
